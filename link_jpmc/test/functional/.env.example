# JPMC LINK Cartridge — Functional Test Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# ENVIRONMENT SELECTION (dev | staging | production)
# ============================================
TEST_ENV=dev

# ============================================
# URLs (replace placeholders with your instance)
# ============================================
DEV_BASE_URL=https://<your-sandbox>.dx.commercecloud.salesforce.com
DEV_LOGIN_URL=https://<your-sandbox>.dx.commercecloud.salesforce.com/on/demandware.store/Sites-<YourSite>-Site/en_US/Login-Show
DEV_HOME_URL=https://<your-sandbox>.dx.commercecloud.salesforce.com/on/demandware.store/Sites-<YourSite>-Site/en_US/

STAGING_BASE_URL=https://<your-staging>.dx.commercecloud.salesforce.com
STAGING_LOGIN_URL=https://<your-staging>.dx.commercecloud.salesforce.com/on/demandware.store/Sites-<YourSite>-Site/en_US/Login-Show
STAGING_HOME_URL=https://<your-staging>.dx.commercecloud.salesforce.com/on/demandware.store/Sites-<YourSite>-Site/en_US/

PROD_BASE_URL=https://<your-production>.dx.commercecloud.salesforce.com
PROD_LOGIN_URL=https://<your-production>.dx.commercecloud.salesforce.com/on/demandware.store/Sites-<YourSite>-Site/en_US/Login-Show
PROD_HOME_URL=https://<your-production>.dx.commercecloud.salesforce.com/on/demandware.store/Sites-<YourSite>-Site/en_US/

# ============================================
# TEST CREDENTIALS (use test accounts only)
# ============================================
DEV_TEST_USER_EMAIL=
DEV_TEST_USER_PASSWORD=
DEV_INVALID_USER_EMAIL=invalid@test.com
DEV_INVALID_USER_PASSWORD=WrongPass123

STAGING_TEST_USER_EMAIL=
STAGING_TEST_USER_PASSWORD=
STAGING_INVALID_USER_EMAIL=invalid@test.com
STAGING_INVALID_USER_PASSWORD=WrongPass456

PROD_TEST_USER_EMAIL=
PROD_TEST_USER_PASSWORD=
PROD_INVALID_USER_EMAIL=invalid@test.com
PROD_INVALID_USER_PASSWORD=WrongPass789

# ============================================
# EXECUTION
# ============================================
HEADLESS=false

# Slow motion (in milliseconds, 0 = no slowdown)
SLOW_MO=2000

# ============================================
# TIMEOUTS (ms)
# ============================================
DEFAULT_TIMEOUT=150000
NAVIGATION_TIMEOUT=600000
ACTION_TIMEOUT=15000
EXPECT_TIMEOUT=15000

# Fixed waits (ms) — used by page objects between interactions
WAIT_SHORT=500
WAIT_MEDIUM=1500
WAIT_LONG=3000

# ============================================
# CI (set by pipeline, not manually)
# ============================================
CI=false
