    <custom-type type-id="JPMCDropInOrdersNotifications">
        <display-name xml:lang="x-default">JPMC Drop-In Orders Notifications</display-name>
        <description xml:lang="x-default">Durable queue for incoming JPMC checkout notifications (order, token, profile). Messages are acknowledged immediately upon receipt, processed asynchronously to update orders, then deleted. Contains no PII or sensitive payment data.</description>
        <staging-mode>no-staging</staging-mode>
        <storage-scope>site</storage-scope>
        <key-definition attribute-id="messageId">
            <type>string</type>
            <min-length>1</min-length>
        </key-definition>
        <attribute-definitions>
            <attribute-definition attribute-id="status">
                <display-name xml:lang="x-default">Processing Status</display-name>
                <description xml:lang="x-default">Current processing state: NEW (awaiting), PROCESSING (active), SUCCESS (completed), FAILED (permanent failure, manual review), ERROR (transient error, will retry)</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <value-definitions>
                    <value-definition>
                        <display xml:lang="x-default">New</display>
                        <value>NEW</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Processing</display>
                        <value>PROCESSING</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Success</display>
                        <value>SUCCESS</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Failed (Manual Review Required)</display>
                        <value>FAILED</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Error (Transient)</display>
                        <value>ERROR</value>
                    </value-definition>
                </value-definitions>
                <default-value>NEW</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="merchantOrderNumber">
                <display-name xml:lang="x-default">Merchant Order Number</display-name>
                <description xml:lang="x-default">Order number from the notification (for linking to storefront Order). Allows bulk queries by order.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <field-length>255</field-length>
            </attribute-definition>
            <attribute-definition attribute-id="messagePayload">
                <display-name xml:lang="x-default">Message Payload</display-name>
                <description xml:lang="x-default">Full JPMC notification message as JSON (may contain orderNotification, tokenNotification, or profileNotification nested object)</description>
                <type>text</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="receiptHandle">
                <display-name xml:lang="x-default">Receipt Handle</display-name>
                <description xml:lang="x-default">JPMC queue receipt handle for acknowledgement after successful processing</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="createdAt">
                <display-name xml:lang="x-default">Created At</display-name>
                <description xml:lang="x-default">Server timestamp when the notification was received and queued</description>
                <type>datetime</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="processedAt">
                <display-name xml:lang="x-default">Processed At</display-name>
                <description xml:lang="x-default">Server timestamp when processing completed (success or error)</description>
                <type>datetime</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="errorMessage">
                <display-name xml:lang="x-default">Error Message</display-name>
                <description xml:lang="x-default">Error details from the last failed processing attempt (no PII)</description>
                <type>text</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
        </attribute-definitions>
        <group-definitions>
            <attribute-group group-id="JPMCDropInOrdersNotifications">
                <display-name xml:lang="x-default">JPMC Drop-In Orders Notifications</display-name>
                <attribute attribute-id="messageId"/>
                <attribute attribute-id="merchantOrderNumber"/>
                <attribute attribute-id="status"/>
                <attribute attribute-id="messagePayload"/>
                <attribute attribute-id="receiptHandle"/>
                <attribute attribute-id="createdAt"/>
                <attribute attribute-id="processedAt"/>
                <attribute attribute-id="errorMessage"/>
                <attribute attribute-id="creationDate" system="true"/>
                <attribute attribute-id="lastModified" system="true"/>
            </attribute-group>
        </group-definitions>
    </custom-type>
